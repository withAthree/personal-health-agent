# 复制为 .env 后按需修改

# 应用
DEBUG=true
SECRET_KEY=dev-secret-change-me

# 基础设施
DATABASE_URL=postgresql+psycopg://pha:123456@localhost:5432/pha
REDIS_URL=redis://:123456@localhost:6379/0
BACKEND_PORT=8000

# LLM（硅基流动，OpenAI 兼容接口）
# LLM_API_KEY 需自行填写，不要提交真实密钥
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
# 模型名默认写在 agent_app/config.py，开发期直接改那里就行（uvicorn --reload 会
# 自动重启进程）。这里配了会覆盖代码默认值，留到上线或临时切换时再用；改完要
# 重建容器（cd docker && docker compose up -d backend）——restart 不会重读本文件。
# LLM_MODEL=deepseek-ai/DeepSeek-V3.2
# 旁路任务各自选型，留空则回落到 LLM_MODEL。两者与对话的性质不同：摘要（上下文
# 压缩）在用户等待路径上，要便宜快；记忆抽取在后台，要能稳定吐结构化输出。
# LLM_SUMMARY_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
# LLM_MEMORY_MODEL=Qwen/Qwen2.5-7B-Instruct
# 让对话模型输出思维链（前端渲染成可折叠的「深度思考」面板）。
# 实测开启后输出 token 约 30 倍、首个正文分片从几秒推迟到几十秒，默认关；
# 关着时前端只是收不到 thinking 块，其余完全一样。
LLM_ENABLE_THINKING=false
