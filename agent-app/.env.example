# 复制为 .env 后按需修改

# 应用
DEBUG=true
SECRET_KEY=dev-secret-change-me

# 基础设施
DATABASE_URL=postgresql+psycopg://pha:123456@localhost:5432/pha
REDIS_URL=redis://:123456@localhost:6379/0
BACKEND_PORT=8000

# LLM（硅基流动，OpenAI 兼容接口）
# LLM_API_KEY 需自行填写，不要提交真实密钥
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
# 换模型只改下面这一行，然后重启后端容器（cd docker && docker compose up -d backend）。
# 注意：这里配了就会覆盖 agent_app/config.py 里的默认值。
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
# 让对话模型输出思维链（前端渲染成可折叠的「深度思考」面板）。
# 实测开启后输出 token 约 30 倍、首个正文分片从几秒推迟到几十秒，默认关；
# 关着时前端只是收不到 thinking 块，其余完全一样。
LLM_ENABLE_THINKING=false
