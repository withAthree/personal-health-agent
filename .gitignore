# ============================================================
# personal-health-agent 仓库级忽略规则
#
# 本文件只管仓库根。以下子目录有各自的 .gitignore，嵌套规则优先，
# 本文件不会覆盖它们的白名单：
#   - .aoci/             AOCI 认知与治理资产（默认全忽略 + 白名单放行）
#   - document/frontend/ 前端脚手架自带规则
# ============================================================

# ------------------------------------------------------------
# 通用
# ------------------------------------------------------------
*.log
logs/
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# 编辑器与 IDE
# ------------------------------------------------------------
# 忽略个人设置，但保留可共享到团队的配置
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/

# ------------------------------------------------------------
# Python（agent-app）
# ------------------------------------------------------------
# 注意：agent-app/.python-version 已入库，故意不忽略
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
env/

# 构建与打包产物
build/
dist/
*.egg-info/
.eggs/

# 工具缓存与测试产物
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# uv
.uv/

# ------------------------------------------------------------
# Node / 前端（web-app、document/frontend）
# ------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo
vite.config.ts.timestamp-*

# 包管理器缓存
.npm/
.pnpm-store/
.yarn/

# ------------------------------------------------------------
# 环境变量与密钥
# ------------------------------------------------------------
# .env.example 是可提交的模板，必须放行
.env
.env.*
!.env.example

# ------------------------------------------------------------
# 本地数据与容器运行时产物
# ------------------------------------------------------------
# docker-compose 用命名卷管理数据；若改为本地 bind mount，数据目录不入库
pgvector_data/
redis_data/
postgres_data/

# 上传目录（document/docker-compose.yml 挂载 ./uploads）
uploads/

# 本地数据库文件
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------
# 本地 AI 工具目录（不入库）
# ------------------------------------------------------------
# Claude Code 的技能入口，实际是指向 .agents/skills/ 的软链接，
# 链接目标是本机绝对路径（换机器/Windows 下会失效）；正本已在 .agents/skills/ 版本管理
.claude/skills/

# WorkBuddy 的本地记忆与状态
# 只忽略它的子目录。不要写成 `document/`——那会把整个文档目录对新文件屏蔽掉，
# 已跟踪的文档看不出异常，新写的文档会静默不入库。
document/.workbuddy-ai/

# ------------------------------------------------------------
# 测试代码（不入库）
# ------------------------------------------------------------
# 只对**未跟踪**的文件生效。已经在版本库里的那几个测试文件与两个 conftest.py 不受它
# 影响，要靠 `git rm --cached` 移出版本库（已做，删除记录在下一次提交里落地）。
agent-app/tests/
#
# agent-app/conftest.py 刻意不在上面这个忽略目录里：它已被 AOCI 纳入受管理范围，而
# AOCI 看不见被 gitignore 覆盖的文件——把 conftest.py 单独加回忽略名单，会让它的认知
# 条目当场变成孤儿，而且没有自动删除路径。「测试代码不入库」与「AOCI 要不要管理它」
# 是两件事，不要合并成一条规则。
